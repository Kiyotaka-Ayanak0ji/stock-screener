# Hosted (Lovable Cloud) backend template.
#
# The real values are written into `.env` automatically by the Cloud
# connection — do not edit `.env` by hand. Use this file as a reference when
# you need to point a separate build (CI, another host) at the hosted backend.
#
# Both the URL and the publishable/anon key are public by design; Row Level
# Security protects the data. The service role key is never used in the client.

VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<publishable-anon-key>
VITE_SUPABASE_PROJECT_ID=<project-ref>

# To run fully locally instead, copy `.env.example` over `.env` — the local
# defaults point at http://localhost:54321 and no cloud service is contacted.
