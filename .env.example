# ---------------------------------------------------------------------------
# EquityIQ environment configuration
#
# Copy to `.env` and adjust. Every value below has a sensible local default.
# No secret is ever committed: this file contains placeholders only.
# ---------------------------------------------------------------------------

# --- Frontend (Vite, inlined at build time, safe to ship in the browser) ----
# Point these at any Supabase compatible backend: Supabase.com, a self hosted
# Supabase stack, or a local `supabase start` instance.
VITE_SUPABASE_URL=http://localhost:54321
VITE_SUPABASE_PUBLISHABLE_KEY=<anon-key>
VITE_SUPABASE_PROJECT_ID=local

# Optional public site URL used for share links and email deep links.
VITE_SITE_URL=http://localhost:8080

# --- Database ---------------------------------------------------------------
# Used by scripts/migrate.sh and by backup/restore tooling.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres

# --- Edge function runtime secrets ------------------------------------------
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY / SUPABASE_DB_URL
# are injected by the platform. Do not set them by hand.

# Branding and sender identity used by every email template.
SITE_NAME=EquityIQ
SITE_URL=http://localhost:8080
MAIL_FROM_DOMAIN=example.com
MAIL_SENDER_DOMAIN=notify.example.com
MAIL_FROM_ADDRESS=noreply@example.com

# --- Email transport --------------------------------------------------------
# smtp | resend | http | lovable   (auto detected when unset)
EMAIL_PROVIDER=smtp

# smtp: works fully offline, e.g. against Mailpit in docker-compose.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_TLS=false
SMTP_USER=
SMTP_PASSWORD=

# resend: hosted alternative
# RESEND_API_KEY=
# RESEND_API_URL=https://api.resend.com/emails

# http: any self hosted JSON endpoint that accepts { to, from, subject, html }
# EMAIL_HTTP_URL=http://mail-relay:8080/send
# EMAIL_HTTP_TOKEN=

# --- Auth email hook --------------------------------------------------------
# The `v1,whsec_...` secret from the Supabase "Send Email" auth hook.
# When set, the auth hook verifies requests with the Standard Webhooks scheme
# and no cloud service is involved.
SEND_EMAIL_HOOK_SECRET=

# --- Third party integrations (all optional) --------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
GROWW_API_TOKEN=

# Secret required by the monthly report cron trigger.
MONTHLY_REPORT_CRON_SECRET=
